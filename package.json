{
  "name": "lpu-belt-explorer-monorepo",
  "version": "0.0.1",
  "repository": "git@github.com:Lockpickers-United/lpu-belt-explorer.git",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web --",
    "build": "npm run build --workspace=apps/web --",
    "build:test": "npm run build:test --workspace=apps/web --",
    "preview": "npm run preview --workspace=apps/web --",
    "lint": "npm run lint --workspace=apps/web --",
    "ci-pr": "npm run ci-pr --workspace=apps/web --",
    "test": "node scripts/testWorkspaces.js",
    "test:run": "npm run test:run --workspace=apps/web --",
    "test:ci": "npm run test:ci --workspace=apps/web --",
    "test:coverage": "npm run test:coverage --workspace=apps/web --",
    "test:functions:integration": "npm run test:functions:integration --workspace=apps/web --",
    "e2e": "npm run e2e --workspace=apps/web --",
    "prepare": "husky",
    "lint:api": "npm run lint --workspace=apps/api --",
    "test:api": "npm run test --workspace=apps/api --",
    "validate:api": "npm run validate --workspace=apps/api --",
    "validate:all": "npm run ci-pr && npm run validate:api"
  },
  "engines": {
    "node": ">=24.11.0 <25",
    "npm": "11.19.0"
  },
  "devDependencies": {
    "husky": "^9.1.7"
  },
  "overrides": {
    "gaxios@6.7.1": {
      "uuid": "11.1.1"
    },
    "react-is": "^19.3.0",
    "gaxios": {
      "uuid": "^11.1.1"
    }
  },
  "allowScripts": {
    "protobufjs": false,
    "unrs-resolver@1.12.2": true,
    "fsevents@2.3.3": true,
    "@firebase/util": false,
    "msw": false
  },
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "create-devvit": "^0.15.1",
    "long": "^5.3.2"
  }
}
