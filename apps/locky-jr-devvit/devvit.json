
{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "locky-jr",
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "permissions": {
    "reddit": {
      "enable": true,
      "scope": "moderator"
    },
    "http": {
      "enable": true,
      "domains": ["discord.com", "api.lpubelts.com"]
    }
  },
  "triggers": {
    "onModMail": "/internal/triggers/modmail"
  },
  "settings": {
    "subreddit": {
      "installationDiscordWebhookUrl": {
        "type": "string",
        "label": "Discord Webhook URL"
      }
    }
  },
  "scripts": {
    "build": "vite build"
  }
}
