# Copy this file to .env.local and replace placeholders for local development.
# Never commit service-account files, API keys, credentials, or production paths.

# Runtime safety. Production requires both LPU_JOB_ENV=production and
# ALLOW_PRODUCTION_JOB=true; keep these local-safe defaults in copied templates.
LPU_JOB_ENV=local
ALLOW_PRODUCTION_JOB=false

# API server. NODE_ENV selects .env.local, .env.development, or .env.production.
# APP_RELEASE_ID and APP_GIT_SHA are optional for local/development runs
# deployment workflow writes equivalent values to .release.json.
API_PORT=8081
HOST=127.0.0.1
CORS_ORIGIN=http://localhost:3000
TRUST_PROXY=loopback
APP_RELEASE_ID=local-development
APP_GIT_SHA=0000000000000000000000000000000000000000

CLASSIFICATION_CATALOG_PATH=/absolute/path/to/classification-catalog.json
CLASSIFICATION_WRITE_STAGE=read|vote|action|publish

# Firebase and request-lock handling.
FIREBASE_PROJECT_ID=replace-with-firebase-project-id
FIRESTORE_DATABASE_ID=replace-with-non-production-database-id
FIREBASE_SERVICE_ACCOUNT_PATH=/absolute/path/to/firebase-service-account.json
REQUESTED_LOCKS_UPLOAD_DIR=/absolute/path/to/requested-lock-uploads
REQUESTED_LOCKS_PUBLIC_URL=http://localhost:8081/requested-lock-uploads

BELT_REQUEST_WEBHOOK_TARGET=test|production
BELT_REQUEST_WEBHOOK_URL='https://discord.com/api/webhooks/your-url'

TEST_WEBHOOK_URL='https://discord.com/api/webhooks/your-url'
LPU_MODS_WEBHOOK_URL='https://discord.com/api/webhooks/your-url'
LPU_LOCKS_WEBHOOK_URL='https://discord.com/api/webhooks/your-url'
LPU_ANNOUNCE_REACT_WEBHOOK_URL='https://discord.com/api/webhooks/your-url'
OLD_TEST_WEBHOOK_URL='https://discord.com/api/webhooks/your-url'

# Collection exports, backups, generated analysis, and public API data.
COLLECTION_EXPORT_DIR=/absolute/path/to/collection-exports
COLLECTION_BACKUP_DIR=/absolute/path/to/collection-backups
COLLECTION_DAILY_DIR=/absolute/path/to/collection-daily-files
COLLECTION_API_DIR=/absolute/path/to/collection-api-data
COLLECTION_PUBLIC_DATA_DIR=/absolute/path/to/public-data
COLLECTIONS_EXPORT_LOOKBACK_MS=300000

# Content uploads.
CONTENT_UPLOAD_DIR=/absolute/path/to/content-uploads

# Email form. Enabling this can send email through the configured mail service.
EMAIL_FORM_ENABLED=false
EMAIL_CONFIG_PATH=/absolute/path/to/emailConfigurations.js

#legacy keys support
DEPRECATED_KEYS_DIR=/absolute/path/to/keys_deprecated

# RAFL preview import.
RAFL_PREVIEW_ENABLED=false
RAFL_SHEET_ID=replace-with-google-sheet-id
RAFL_PREVIEW_OUTPUT_DIR=/absolute/path/to/rafl-preview-output
RAFL_PREVIEW_TIMEOUT_MS=15000

# Reddit belt refresh.
REDDIT_BELTS_ENABLED=false
REDDIT_BELTS_SCRIPT_PATH=/absolute/path/to/fetch_reddit_flairs.py
REDDIT_CREDENTIALS_PATH=/absolute/path/to/reddit-credentials.json
REDDIT_BELTS_OUTPUT_DIR=/absolute/path/to/public-data

# Member Reddit OAuth import. Use a separate Reddit web app per environment.
# The callback must exactly match the app's single registered root URI.
# Development: https://dev.lpubelts.com/  Production: https://lpubelts.com/
# Keep the secret in protected server configuration, never in frontend VITE_* values.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_REDIRECT_URI=
REDDIT_USER_AGENT=

# Discord belt-count refresh. Disabled jobs use the existing reviewed snapshot
# at COLLECTION_PUBLIC_DATA_DIR/discordBeltCounts.json.
DISCORD_BELT_COUNTS_REFRESH_ENABLED=false
DISCORD_BELT_COUNTS_URL=https://explore.lpubelts.com/data/discordBeltCounts.json
DISCORD_BELT_COUNTS_TIMEOUT_MS=15000
DISCORD_BELT_COUNTS_MAX_BYTES=1048576

# Catalog inputs used by collection analysis and lock statistics. Refresh is
# independent of the selected source and downloads bounded HTTPS snapshots
# before the combined pipeline runs.
# options: ['filesystem', 'remote']
LPU_CATALOG_SOURCE=filesystem
LPU_CATALOG_REFRESH_ENABLED=false
LPU_CATALOG_DIR=/absolute/path/to/catalog-snapshots
LPU_CATALOG_BASE_URL=https://lpubelts.com
LPU_CATALOG_TIMEOUT_MS=15000
LPU_CATALOG_MAX_BYTES=10485760

# Web-log fetch and analysis. FTP credentials belong only in protected .env
# files. Leave refresh disabled unless this job should contact the live host.
LOG_ANALYSIS_FTP_ENABLED=false
LOG_ANALYSIS_FTP_HOST=replace-with-ftp-host
LOG_ANALYSIS_FTP_PORT=21
LOG_ANALYSIS_FTP_USER=replace-with-ftp-user
LOG_ANALYSIS_FTP_PASSWORD=replace-with-ftp-password
LOG_ANALYSIS_FTP_REMOTE_DIR=/logs
LOG_ANALYSIS_FTP_SECURE=false
LOG_ANALYSIS_LOGS_DIR=/absolute/path/to/downloaded-web-logs
LOG_ANALYSIS_DAILY_DATA_DIR=/absolute/path/to/daily-log-analysis
LOG_ANALYSIS_OUTPUT_DIR=/absolute/path/to/public-data

# Flickr album information.
FLICKR_INFO_ENABLED=false
FLICKR_API_KEY=replace-with-flickr-api-key
FLICKR_INFO_TIMEOUT_MS=30000
FLICKR_INFO_MAX_PHOTOS=500
FLICKR_INFO_CONCURRENCY=5

# Firebase activity logging.
FIREBASE_ACTIVITY_LOGGING_ENABLED=false
FIREBASE_ACTIVITY_MAX_BATCH_SIZE=100
FIREBASE_ACTIVITY_MAX_STRING_LENGTH=500
