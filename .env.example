# Copy this file to .env.local and replace placeholders for local development.
# Never commit service-account files, API keys, credentials, or production paths.

# Runtime safety. Production requires both LPU_JOB_ENV=production and
# ALLOW_PRODUCTION_JOB=true; keep these local-safe defaults in copied templates.
LPU_JOB_ENV=local
ALLOW_PRODUCTION_JOB=false

# Firebase and request-lock handling.
FIREBASE_PROJECT_ID=replace-with-firebase-project-id
FIRESTORE_DATABASE_ID=replace-with-non-production-database-id
FIREBASE_SERVICE_ACCOUNT_PATH=/absolute/path/to/firebase-service-account.json
REQUESTED_LOCKS_UPLOAD_DIR=/absolute/path/to/requested-lock-uploads
REQUESTED_LOCKS_PUBLIC_URL=http://localhost:8081/requested-lock-uploads

# Content uploads.
CONTENT_UPLOAD_DIR=/absolute/path/to/content-uploads

# Email form. Enabling this can send email through the configured mail service.
EMAIL_FORM_ENABLED=false

# RAFL preview import.
RAFL_PREVIEW_ENABLED=false
RAFL_SHEET_ID=replace-with-google-sheet-id
RAFL_PREVIEW_OUTPUT_DIR=/absolute/path/to/rafl-preview-output
RAFL_PREVIEW_TIMEOUT_MS=15000

# Reddit belt refresh.
REDDIT_BELTS_ENABLED=false
REDDIT_BELTS_SCRIPT_PATH=/absolute/path/to/fetch_reddit_flairs.py
REDDIT_CREDENTIALS_PATH=/absolute/path/to/reddit-credentials.json
REDDIT_BELTS_OUTPUT_DIR=/absolute/path/to/reddit-output

# Flickr album information.
FLICKR_INFO_ENABLED=false
FLICKR_API_KEY=replace-with-flickr-api-key
FLICKR_INFO_TIMEOUT_MS=30000
FLICKR_INFO_MAX_PHOTOS=500
FLICKR_INFO_CONCURRENCY=5

# Firebase activity logging.
FIREBASE_ACTIVITY_LOGGING_ENABLED=false
FIREBASE_ACTIVITY_MAX_BATCH_SIZE=100
FIREBASE_ACTIVITY_MAX_STRING_LENGTH=500
