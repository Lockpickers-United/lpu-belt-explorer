if [ "${CI:-}" != "true" ] && [ -s "$HOME/.nvm/nvm.sh" ]; then
    unset npm_config_prefix
    . "$HOME/.nvm/nvm.sh"
    nvm use --silent
fi

npm run test:ci

if git diff --cached --name-only | grep -q '^apps/api/'; then
    (
        cd apps/api || exit 1
        if command -v nvm >/dev/null 2>&1; then
            nvm use --silent || exit 1
        elif [ "$(node --version)" != "v$(cat .nvmrc)" ]; then
            echo 'Select the Node version pinned in apps/api/.nvmrc before API validation.' >&2
            exit 1
        fi
        corepack yarn validate
    )
fi
