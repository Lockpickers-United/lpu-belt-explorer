# Synthetic values used only by Vitest and Playwright test builds.
# Automated tests must never fall back to a deployable Firebase project or a live API.
VITE_FIREBASE_API_KEY=test-only-api-key
VITE_FIREBASE_PROJECT_ID=demo-lpubelts-test
VITE_FIREBASE_AUTH_DOMAIN=demo-lpubelts-test.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=demo-lpubelts-test.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:test
VITE_USE_FIREBASE_EMULATORS=true
VITE_AUTH_EMULATOR_HOST=127.0.0.1
VITE_AUTH_EMULATOR_PORT=9099
VITE_FIRESTORE_EMULATOR_HOST=127.0.0.1
VITE_FIRESTORE_EMULATOR_PORT=8080
VITE_DEV_FIRESTORE=false
VITE_LOCAL_DATA=true
VITE_DATA_BASE_URL=/data
VITE_LOCKBAZAAR_DATA_URL=/test-data/lockbazaar-entry-ids.json
VITE_NODE_SERVER_URL=/test-api
VITE_API_SERVER_URL=/test-api
